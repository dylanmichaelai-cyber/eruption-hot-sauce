# ─── YouTube Data API ────────────────────────────────────────────────────────
# Your YouTube Data API v3 key (console.cloud.google.com → APIs & Services → Credentials)
YOUTUBE_API_KEY=AIzaSyDrPa11MXDW3V6A6HU3_mPt7klQjJp5T8c

# Your YouTube Channel ID  (youtube.com/channel/UC... — or find it at:
# youtube.com → your profile → Settings → Advanced settings)
YOUTUBE_CHANNEL_ID=UCxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Anthropic (Claude) API ──────────────────────────────────────────────────
# Get your key at console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# ─── Email (Gmail) ───────────────────────────────────────────────────────────
# Your Gmail address used to SEND the report
EMAIL_FROM=you@gmail.com

# Where the report should be delivered (defaults to EMAIL_FROM if left blank)
EMAIL_TO=you@gmail.com

# Gmail App Password — NOT your normal Gmail password.
# Generate one at: myaccount.google.com → Security → 2-Step Verification → App passwords
# Select "Mail" + your device, then paste the 16-char code below.
EMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
