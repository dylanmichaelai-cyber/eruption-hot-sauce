# YouTube Data API v3 key (console.developers.google.com)
YOUTUBE_API_KEY=your_youtube_api_key_here

# Your channel — provide ONE of these:
YOUTUBE_CHANNEL_ID=UCxxxxxxxxxxxxxxxxxxxxxxxx
# YOUTUBE_CHANNEL_HANDLE=@YourChannelHandle

# Anthropic / Claude API key (console.anthropic.com)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Gmail: sender address and an App Password (not your login password)
# Generate at: myaccount.google.com/apppasswords  (requires 2FA enabled)
EMAIL_FROM=you@gmail.com
EMAIL_TO=you@gmail.com
EMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
