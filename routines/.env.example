# YouTube Data API v3 key (from Google Cloud Console)
YOUTUBE_API_KEY=your_youtube_api_key_here

# Your YouTube channel ID
# Find it: YouTube Studio → Settings → Channel → Advanced settings
YOUTUBE_CHANNEL_ID=UCxxxxxxxxxxxxxxxxxxxxxxxx

# Anthropic API key for Claude analysis
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Gmail address you're sending FROM
EMAIL_FROM=you@gmail.com

# Address to receive the summary (can be the same)
EMAIL_TO=you@gmail.com

# Gmail App Password (NOT your regular password)
# Generate one: Google Account → Security → 2-Step Verification → App passwords
EMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# How many days back to look for videos (default: 30)
DAYS_LOOKBACK=30

# Max videos to analyze (default: 10)
MAX_VIDEOS=10

# Max comments per video (default: 100)
MAX_COMMENTS_PER_VIDEO=100
