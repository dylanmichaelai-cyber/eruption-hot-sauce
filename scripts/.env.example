# YouTube Comment Digest — environment variables
# Copy this file to scripts/.env and fill in the values.
# Never commit scripts/.env to git.

# ── YouTube ───────────────────────────────────────────────────────────────────
# Your YouTube Data API v3 key (Google Cloud Console → APIs & Services → Credentials)
YOUTUBE_API_KEY=AIzaSyDrPa11MXDW3V6A6HU3_mPt7klQjJp5T8c

# Your YouTube Channel ID  (youtube.com/channel/UC... or Settings → Advanced → Channel ID)
YOUTUBE_CHANNEL_ID=

# ── Anthropic ─────────────────────────────────────────────────────────────────
# Your Anthropic API key  (console.anthropic.com)
ANTHROPIC_API_KEY=

# ── Email (Gmail SMTP) ────────────────────────────────────────────────────────
# Who receives the digest
RECIPIENT_EMAIL=d.mcderm80@gmail.com

# Gmail address used to send (usually the same as RECIPIENT_EMAIL)
SMTP_USER=d.mcderm80@gmail.com

# Gmail App Password (NOT your regular Gmail password).
# Generate one at: myaccount.google.com/apppasswords
# (Requires 2-Step Verification to be enabled on your Google Account)
SMTP_PASSWORD=

# ── Optional tuning ───────────────────────────────────────────────────────────
# Number of recent videos to analyze (default: 10)
# MAX_VIDEOS=10

# Max comments fetched per video (default: 50)
# MAX_COMMENTS_PER_VIDEO=50
