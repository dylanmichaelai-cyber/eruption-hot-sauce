# YouTube Data API v3 key (console.cloud.google.com → APIs & Services → Credentials)
YOUTUBE_API_KEY=your_youtube_api_key_here

# Your YouTube channel ID (found in YouTube Studio → Settings → Channel → Advanced)
# Looks like: UCxxxxxxxxxxxxxxxxxxxxxxxx
YOUTUBE_CHANNEL_ID=UCxxxxxxxxxxxxxxxxxxxxxxxx

# Anthropic API key for Claude analysis (console.anthropic.com)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Gmail account that sends the report
GMAIL_USER=you@gmail.com

# Gmail App Password (NOT your normal password)
# Generate at: myaccount.google.com/apppasswords
# Requires 2FA to be enabled on your Google account
GMAIL_APP_PASSWORD=xxxx_xxxx_xxxx_xxxx

# Where to send the report (defaults to GMAIL_USER if not set)
RECIPIENT_EMAIL=you@gmail.com

# Tuning (optional)
MAX_VIDEOS=10
MAX_COMMENTS_PER_VIDEO=75
