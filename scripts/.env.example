# ── YouTube ────────────────────────────────────────────────────────────────
# Your YouTube Data API v3 key (console.cloud.google.com)
YOUTUBE_API_KEY=AIzaSyDrPa11MXDW3V6A6HU3_mPt7klQjJp5T8c

# Your YouTube channel ID  (youtube.com/channel/<ID>  or  @handle → About page → Share → Copy ID)
YOUTUBE_CHANNEL_ID=UCxxxxxxxxxxxxxxxxxxxx

# ── Claude (Anthropic) ─────────────────────────────────────────────────────
# Create at console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-...

# ── Gmail ──────────────────────────────────────────────────────────────────
# The Gmail address that sends the digest
GMAIL_SENDER=you@gmail.com

# Gmail App Password (NOT your regular password).
# Generate at: myaccount.google.com → Security → 2-Step Verification → App passwords
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Where to receive the digest (defaults to GMAIL_SENDER if left blank)
EMAIL_RECIPIENT=you@gmail.com

# ── Tuning (optional) ──────────────────────────────────────────────────────
MAX_VIDEOS=10             # how many recent videos to pull comments from
MAX_COMMENTS_PER_VIDEO=50 # cap per video
LOOKBACK_DAYS=7           # only include videos published in the last N days
