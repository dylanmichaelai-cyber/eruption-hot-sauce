# YouTube Comment Summary — Environment Variables
# Copy this to .env (or export into your shell/cron) and fill in the blanks.
# NEVER commit your real .env file to git.

# ── YouTube ────────────────────────────────────────────────────────────────
YOUTUBE_API_KEY=AIzaSyDrPa11MXDW3V6A6HU3_mPt7klQjJp5T8c

# Your channel ID (starts with UC…).
# Run the script once WITHOUT this set and it will prompt you for your @handle,
# then print the ID so you can paste it here.
YOUTUBE_CHANNEL_ID=

# ── Claude (Anthropic) ────────────────────────────────────────────────────
# Get your key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# ── Gmail ─────────────────────────────────────────────────────────────────
# Use an App Password — NOT your Gmail login password.
# Create one at: https://myaccount.google.com/apppasswords
# (Requires 2-Step Verification to be enabled on your account)
GMAIL_USER=d.mcderm80@gmail.com
GMAIL_APP_PASSWORD=
TO_EMAIL=d.mcderm80@gmail.com

# ── Tuning (optional) ─────────────────────────────────────────────────────
MAX_VIDEOS=5       # how many recent videos to scan
MAX_COMMENTS=50    # max top-level comments per video
DAYS_BACK=30       # only include comments posted in the last N days
