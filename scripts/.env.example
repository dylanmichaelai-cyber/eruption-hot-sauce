# YouTube Data API key (already set in the script as default)
YOUTUBE_API_KEY=AIzaSyDrPa11MXDW3V6A6HU3_mPt7klQjJp5T8c

# Your YouTube channel ID
# Find it: YouTube Studio → Settings → Channel → Advanced settings → Channel ID
YOUTUBE_CHANNEL_ID=UCxxxxxxxxxxxxxxxxxxxxxxxxx

# Anthropic API key for Claude analysis
# Get it: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Gmail credentials for sending the summary
# SMTP_USER is your Gmail address
# SMTP_PASSWORD must be an App Password (NOT your account password)
# Create one at: https://myaccount.google.com/apppasswords
SMTP_USER=you@gmail.com
SMTP_PASSWORD=xxxx xxxx xxxx xxxx

# Where to send the summary (defaults to SMTP_USER if not set)
SUMMARY_EMAIL=you@gmail.com

# Optional tuning
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# MAX_VIDEOS=5
# MAX_COMMENTS=50
