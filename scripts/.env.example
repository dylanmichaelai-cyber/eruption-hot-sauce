# Copy this file to scripts/.env and fill in your values.
# Never commit the .env file — it contains secrets.

# YouTube Data API v3 key (console.cloud.google.com)
YOUTUBE_API_KEY=YOUR_YOUTUBE_API_KEY_HERE

# Your channel ID — find it at youtube.com/account_advanced
# It starts with "UC", e.g. UCxxxxxxxxxxxxxxxxxxxxxxxx
YOUTUBE_CHANNEL_ID=UCxxxxxxxxxxxxxxxxxxxxxxxx

# Anthropic API key for Claude comment analysis (console.anthropic.com)
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY_HERE

# Gmail address you'll send FROM (and receive at by default)
GMAIL_USER=d.mcderm80@gmail.com

# Gmail App Password — NOT your Google login password.
# Enable 2-Step Verification, then go to:
#   myaccount.google.com > Security > 2-Step Verification > App passwords
# Generate one for "Mail" and paste it here (no spaces).
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Optional: send the digest to a different address
# RECIPIENT_EMAIL=someone@example.com
