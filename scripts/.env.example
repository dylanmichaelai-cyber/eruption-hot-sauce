# ── YouTube ──────────────────────────────────────────────
YOUTUBE_API_KEY=YOUR_YOUTUBE_API_KEY_HERE
# Your YouTube channel ID (looks like UCxxxxxxxxxxxxxxxx)
# Find it: youtube.com/account_advanced
YOUTUBE_CHANNEL_ID=YOUR_CHANNEL_ID_HERE

# ── Anthropic (Claude) ────────────────────────────────────
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY_HERE

# ── Tuning (optional) ────────────────────────────────────
DAYS_TO_LOOK_BACK=7
MAX_VIDEOS=10
MAX_COMMENTS_PER_VIDEO=100
