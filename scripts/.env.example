# YouTube Digest — environment variables
# Copy this to .env and fill in your values (never commit .env to git)

# YouTube Data API v3 key — Google Cloud Console > APIs & Services > Credentials
YOUTUBE_API_KEY=your_key_here

# Your channel ID — found at youtube.com/account_advanced
# Looks like: UCxxxxxxxxxxxxxxxxxxxxxxxx
YOUTUBE_CHANNEL_ID=UCxxxxxxxxxxxxxxxxxxxxxxxx

# Where to send the digest
EMAIL_TO=d.mcderm80@gmail.com

# Gmail account used to send the email
GMAIL_USER=your@gmail.com

# Gmail App Password (NOT your regular password)
# Generate at: myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Optional: Enables Claude AI-powered analysis instead of keyword matching
# Get at: console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...
