# Copy this file to scripts/.env and fill in your values.
# Never commit .env — it's listed in .gitignore.

# ── YouTube ──────────────────────────────────────────────────────────────────
# YouTube Data API v3 key (console.cloud.google.com → APIs & Services → Credentials)
YOUTUBE_API_KEY=YOUR_YOUTUBE_API_KEY_HERE

# Your channel ID — find it at youtube.com/account_advanced
# Looks like: UCxxxxxxxxxxxxxxxxxxxxxxxx
YOUTUBE_CHANNEL_ID=YOUR_CHANNEL_ID_HERE

# ── Claude (Anthropic) ────────────────────────────────────────────────────────
# Get your key at console.anthropic.com
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY_HERE

# ── Email (Gmail) ─────────────────────────────────────────────────────────────
# Gmail address the digest is sent FROM (must match the App Password below)
EMAIL_FROM=you@gmail.com

# Address the digest is delivered TO (can be the same as EMAIL_FROM)
EMAIL_TO=you@gmail.com

# Gmail App Password — NOT your regular password.
# Enable 2-Step Verification, then go to:
#   myaccount.google.com/apppasswords → create one for "YouTube Digest"
EMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# ── Optional tuning ───────────────────────────────────────────────────────────
# Number of most-recent videos to scan (default: 10)
MAX_VIDEOS=10

# Max comments fetched per video (default: 50)
MAX_COMMENTS_PER_VIDEO=50
