# YouTube Data API v3 key (console.cloud.google.com)
YOUTUBE_API_KEY=your_youtube_api_key_here

# Your YouTube channel ID (youtube.com/channel/YOUR_ID or use a tool to find it)
# Example: UCxxxxxxxxxxxxxxxxxxxxxx
CHANNEL_ID=your_channel_id_here

# Anthropic API key (console.anthropic.com)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Gmail address you send FROM
GMAIL_ADDRESS=you@gmail.com

# Gmail App Password (myaccount.google.com → Security → App Passwords)
# NOT your regular Gmail password — generate a dedicated app password
GMAIL_APP_PASSWORD=xxxx_xxxx_xxxx_xxxx

# Where to send the digest (defaults to GMAIL_ADDRESS if not set)
RECIPIENT_EMAIL=you@gmail.com

# How many recent videos to analyze (default: 5)
VIDEOS_TO_CHECK=5

# Max comments to pull per video (default: 50)
COMMENTS_PER_VIDEO=50
