# YouTube Data API v3 key
YOUTUBE_API_KEY=your_youtube_api_key_here

# Your YouTube channel ID (looks like UCxxxxxxxxxxxxxxxxxxxxxxxx)
# Find it at: youtube.com → Your profile → Settings → Advanced settings
YOUTUBE_CHANNEL_ID=UCxxxxxxxxxxxxxxxxxxxxxxxx

# Anthropic API key for Claude analysis
# Get one at: console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Email settings (Gmail recommended)
# For Gmail: enable 2FA, then create an App Password at:
#   myaccount.google.com → Security → App passwords
EMAIL_FROM=you@gmail.com
EMAIL_TO=you@gmail.com
EMAIL_APP_PASSWORD=xxxx_xxxx_xxxx_xxxx

# Optional — override defaults
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# MAX_VIDEOS=10
# MAX_COMMENTS_PER_VIDEO=50
