# YouTube Data API v3 key — https://console.cloud.google.com
YOUTUBE_API_KEY=your_youtube_api_key_here

# Your YouTube channel ID (e.g. UCxxxxxxxxxxxxxxxxxxxxxxxx)
# Find it at: youtube.com/account_advanced
YOUTUBE_CHANNEL_ID=your_channel_id_here

# Anthropic API key — https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Gmail address you want to send the digest FROM (must be the same account as the app password)
GMAIL_ADDRESS=you@gmail.com

# Gmail App Password (NOT your regular password)
# Generate one at: myaccount.google.com/apppasswords  (requires 2-Step Verification enabled)
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Where to send the digest email (can be same as GMAIL_ADDRESS)
DIGEST_RECIPIENT=you@gmail.com

# How many of your most recent videos to scan (default: 5)
VIDEOS_TO_SCAN=5

# Max comments to pull per video (default: 100)
MAX_COMMENTS_PER_VIDEO=100
