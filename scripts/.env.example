# YouTube Data API v3 key
YOUTUBE_API_KEY=your_youtube_api_key_here

# Your channel ID (found at youtube.com/channel/<ID> or via Settings > Advanced)
YOUTUBE_CHANNEL_ID=UCxxxxxxxxxxxxxxxxxxxxxxxx

# Anthropic API key for Claude analysis
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Gmail address you're sending FROM (must match the app password account)
EMAIL_FROM=you@gmail.com

# Address to receive the report (can be the same as EMAIL_FROM)
EMAIL_TO=you@gmail.com

# Gmail App Password (NOT your regular Gmail password)
# Generate at: https://myaccount.google.com/apppasswords
# Requires 2-Step Verification to be enabled on your Google account
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Optional tuning
MAX_VIDEOS=5
MAX_COMMENTS_PER_VIDEO=50
