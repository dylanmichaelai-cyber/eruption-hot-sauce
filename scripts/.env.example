# ── YouTube Data API ──────────────────────────────────────────────────────────
# Get your key at: https://console.cloud.google.com → APIs & Services → Credentials
YOUTUBE_API_KEY=your_youtube_data_api_key_here

# Your YouTube channel ID (looks like UCxxxxxxxxxxxxxxxxxxxxxxxx)
# Find it: YouTube Studio → Settings → Channel → Advanced settings → Channel ID
YOUTUBE_CHANNEL_ID=UCxxxxxxxxxxxxxxxxxxxxxxxx

# ── Anthropic / Claude ────────────────────────────────────────────────────────
# Get your key at: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# ── Email (Gmail) ─────────────────────────────────────────────────────────────
# The email address to SEND the report TO
RECIPIENT_EMAIL=you@example.com

# The Gmail account used to SEND (must have an App Password set up)
GMAIL_USER=yourgmail@gmail.com

# Gmail App Password — NOT your regular password.
# Set one up: myaccount.google.com → Security → 2-Step Verification → App passwords
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# ── Optional tuning ───────────────────────────────────────────────────────────
# How many of your most recent videos to scan (default: 5)
MAX_VIDEOS=5

# Max comments to pull per video (default: 75)
MAX_COMMENTS_PER_VIDEO=75
