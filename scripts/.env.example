# Copy this to .env and fill in your values
# NEVER commit .env to git

# YouTube Data API v3 key (console.cloud.google.com)
YOUTUBE_API_KEY=YOUR_YOUTUBE_API_KEY_HERE

# Your channel ID — find it at:
#   youtube.com → your profile → Settings → Advanced settings
#   It looks like: UCxxxxxxxxxxxxxxxxxxxxxx
YOUTUBE_CHANNEL_ID=YOUR_CHANNEL_ID_HERE

# Anthropic API key (console.anthropic.com)
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY_HERE

# Gmail address you'll send FROM
EMAIL_SENDER=you@gmail.com

# Gmail App Password (NOT your login password)
# Generate one at: myaccount.google.com → Security → 2-Step Verification → App passwords
EMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Address to receive the digest (can be the same as EMAIL_SENDER)
EMAIL_RECIPIENT=you@gmail.com

# Optional tuning
MAX_VIDEOS=10               # How many recent videos to scan
MAX_COMMENTS_PER_VIDEO=50   # Max comments to pull per video
DAYS_LOOKBACK=30            # Only include comments newer than N days (0 = all time)
