# ── YouTube ─────────────────────────────────────────────────────────────────
YOUTUBE_API_KEY=YOUR_YOUTUBE_API_KEY_HERE

# Your channel ID — find it at youtube.com > your profile > Settings > Advanced
# It looks like: UCxxxxxxxxxxxxxxxxxxxxxxxx
YOUTUBE_CHANNEL_ID=UCxxxxxxxxxxxxxxxxxxxxxxxx

# How many recent videos to scan (default: 5)
MAX_VIDEOS=5

# Max comments to pull per video (default: 100, YouTube API cap is 100)
MAX_COMMENTS_PER_VIDEO=100

# ── Claude / Anthropic ───────────────────────────────────────────────────────
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY_HERE

# ── Email (Gmail SMTP) ───────────────────────────────────────────────────────
# For Gmail: generate an App Password at myaccount.google.com/apppasswords
# (requires 2-Step Verification to be enabled)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=xxxx xxxx xxxx xxxx

# Where the digest gets delivered (can be the same as SMTP_USER)
RECIPIENT_EMAIL=you@gmail.com
