# Copy this file to scripts/.env and fill in your values.
# Then run:  source scripts/.env && python3 scripts/youtube_comment_digest.py

# ── YouTube ───────────────────────────────────────────────────────────────────
# Your YouTube Data API v3 key (Google Cloud Console → APIs & Services → Credentials)
export YOUTUBE_API_KEY=AIzaSy...

# Your channel ID — find it at https://www.youtube.com/account_advanced
export YOUTUBE_CHANNEL_ID=UCxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Anthropic ─────────────────────────────────────────────────────────────────
# Claude API key from https://console.anthropic.com
export ANTHROPIC_API_KEY=sk-ant-...

# ── Gmail (for sending the digest) ───────────────────────────────────────────
# The Gmail address the digest is sent FROM.
# Requires an App Password (not your real password).
# Create one at: https://myaccount.google.com/apppasswords
export GMAIL_FROM=you@gmail.com
export GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Email address to RECEIVE the digest (can be the same as GMAIL_FROM)
export DIGEST_RECIPIENT=d.mcderm80@gmail.com
