# Copy this to .env (never commit .env) or set these as GitHub Secrets.

# 1. YouTube Data API v3 key
#    Create at: https://console.cloud.google.com → APIs & Services → Credentials
#    Enable "YouTube Data API v3" for the project first.
YOUTUBE_API_KEY=YOUR_YOUTUBE_API_KEY

# 2. Your YouTube channel ID  (looks like UCxxxxxxxxxxxxxxxxxx)
#    Find it: YouTube Studio → Customization → Basic info → Channel URL
#    Or: youtube.com/channel/UCxxxxxxxxxx — the part after /channel/
YOUTUBE_CHANNEL_ID=YOUR_CHANNEL_ID

# 3. Anthropic API key for Claude-powered analysis
#    Get one at: https://console.anthropic.com/
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY

# 4. Gmail credentials — use an App Password, NOT your login password.
#    Enable 2FA on your Google account, then:
#    myaccount.google.com → Security → App Passwords → Mail
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# 5. Where to send the summary (defaults to GMAIL_USER if omitted)
RECIPIENT_EMAIL=d.mcderm80@gmail.com
