# ─── YouTube ───────────────────────────────────────────────────────────────────
# Your YouTube Data API v3 key (from Google Cloud Console)
YOUTUBE_API_KEY=AIzaSy...

# Your channel ID — find it at youtube.com/account_advanced
# It looks like: UCxxxxxxxxxxxxxxxxxxxxxxxxxx
YOUTUBE_CHANNEL_ID=UC...

# How many recent videos to scan (default: 10)
MAX_VIDEOS=10

# Max comments to pull per video (default: 50, YouTube max per request: 100)
MAX_COMMENTS_PER_VIDEO=50

# ─── Claude / Anthropic ────────────────────────────────────────────────────────
# Get your key at console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# ─── Email (Gmail) ─────────────────────────────────────────────────────────────
# Your Gmail address
EMAIL_ADDRESS=you@gmail.com

# Gmail App Password (NOT your regular password)
# Generate one at: myaccount.google.com > Security > App Passwords
# Requires 2-Step Verification to be enabled on your Google account.
EMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Where to send the summary (defaults to EMAIL_ADDRESS if not set)
RECIPIENT_EMAIL=you@gmail.com
