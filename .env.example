# YouTube Data API v3
# Get key at: console.cloud.google.com > APIs > Credentials
# Make sure "YouTube Data API v3" is enabled for the key
YOUTUBE_API_KEY=your_youtube_api_key_here

# Your YouTube channel ID
# Find it: YouTube Studio > Customization > Basic info > Channel URL
# It looks like: UCxxxxxxxxxxxxxxxxxxxxxx
YOUTUBE_CHANNEL_ID=UCxxxxxxxxxxxxxxxxxxxxxx

# How many recent videos and comments to scan
YOUTUBE_MAX_VIDEOS=10
YOUTUBE_MAX_COMMENTS=100

# Anthropic API key for Claude analysis
# Get one at: console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Gmail SMTP credentials for sending email
# GMAIL_APP_PASSWORD: myaccount.google.com > Security > 2-Step Verification > App passwords
GMAIL_ADDRESS=dylanmichaelai@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password_here
