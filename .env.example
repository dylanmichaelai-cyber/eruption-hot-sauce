# YouTube Comments Routine — Environment Variables
# Add these in the Cloud Environment section when creating your Routine
# at claude.ai/code/routines

YOUTUBE_API_KEY=your_youtube_data_api_v3_key_here
YOUTUBE_CHANNEL_ID=your_channel_id_here   # find at youtube.com/account_advanced

# Optional — tune how many comments to pull
MAX_VIDEOS=5
MAX_COMMENTS_PER_VIDEO=50
