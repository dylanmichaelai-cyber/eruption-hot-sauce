# YouTube Data API v3 key (https://console.cloud.google.com)
YOUTUBE_API_KEY=your_youtube_api_key_here

# Your YouTube Channel ID (found at youtube.com/channel/YOUR_ID or via About page > Share > Copy channel ID)
YOUTUBE_CHANNEL_ID=your_channel_id_here

# Anthropic API key for Claude analysis (https://console.anthropic.com)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Gmail address to send FROM (must have 2FA + App Password enabled)
EMAIL_SENDER=you@gmail.com

# Gmail App Password (NOT your regular password — generate at myaccount.google.com/apppasswords)
EMAIL_APP_PASSWORD=your_16_char_app_password

# Address to receive the summary email
EMAIL_RECIPIENT=you@gmail.com

# How many recent videos to analyze (default: 10)
MAX_VIDEOS=10

# Max comments to fetch per video (default: 100)
MAX_COMMENTS_PER_VIDEO=100
