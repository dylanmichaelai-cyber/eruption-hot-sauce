# ── YouTube ───────────────────────────────────────────────────────────────────
YOUTUBE_API_KEY=YOUR_YOUTUBE_DATA_API_V3_KEY
# Find your channel ID at: youtube.com/account_advanced
YOUTUBE_CHANNEL_ID=UCxxxxxxxxxxxxxxxxxxxxxx

# ── Anthropic (Claude) ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
EMAIL_FROM=you@gmail.com
EMAIL_TO=you@gmail.com        # where the digest is delivered

SMTP_HOST=smtp.gmail.com      # Gmail default — change for other providers
SMTP_PORT=587

SMTP_USER=you@gmail.com
# Gmail: create an App Password at myaccount.google.com/apppasswords
# (requires 2FA to be enabled on your Google account)
SMTP_PASSWORD=xxxx xxxx xxxx xxxx

# ── Tuning ────────────────────────────────────────────────────────────────────
LOOKBACK_DAYS=7       # how many days of comments to pull
MAX_COMMENTS=200      # cap to keep Claude API costs low
