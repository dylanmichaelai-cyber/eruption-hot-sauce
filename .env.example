# YouTube Data API v3 key (console.cloud.google.com → APIs & Services → Credentials)
YOUTUBE_API_KEY=your_youtube_api_key_here

# Your channel ID (youtube.com/account_advanced) OR your @handle — one is enough
YOUTUBE_CHANNEL_ID=
YOUTUBE_CHANNEL_HANDLE=@YourChannelHandle

# Anthropic API key (console.anthropic.com)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Gmail address you're sending FROM (must be a Gmail account)
EMAIL_FROM=you@gmail.com

# Email address to receive the summary (can be the same as above)
EMAIL_TO=you@gmail.com

# Gmail App Password — NOT your regular login password
# Generate one at: myaccount.google.com/apppasswords (requires 2FA enabled)
EMAIL_APP_PASSWORD=your_16_char_app_password

# How many recent videos and comments to fetch (optional)
MAX_VIDEOS=8
MAX_COMMENTS_PER_VIDEO=50
