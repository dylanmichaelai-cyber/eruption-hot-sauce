EMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# ── Tuning (optional) ─────────────────────────────────────────────────────────
VIDEOS_TO_SCAN=5        # How many recent videos to pull
COMMENTS_PER_VIDEO=100  # Max comments per video
DAYS_BACK=30            # Look back this many days for new videos
