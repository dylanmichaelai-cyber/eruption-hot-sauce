# YouTube Comment Summary – Environment Variables
# Copy this to .env and fill in your values, then:
#   source .env && python3 youtube_comment_summary.py

# YouTube Data API v3 key
# Create/manage at: console.cloud.google.com → APIs & Services → Credentials
# Must have "YouTube Data API v3" enabled in your project
YOUTUBE_API_KEY=AIzaSyDrPa11MXDW3V6A6HU3_mPt7klQjJp5T8c

# Your YouTube channel ID  (starts with UC...)
# Find it: youtube.com → your channel → About → Share → Copy channel ID
# Or use your @handle directly, e.g. @EruptionHotSauce
YOUTUBE_CHANNEL_ID=UCxxxxxxxxxxxxxxxxxxxxxx

# Anthropic API key for Claude AI analysis
# Get one at: console.anthropic.com
ANTHROPIC_API_KEY=

# Gmail credentials for sending the report
GMAIL_ADDRESS=d.mcderm80@gmail.com
# Generate an App Password (NOT your login password) at:
#   myaccount.google.com/apppasswords  (requires 2FA enabled)
GMAIL_APP_PASSWORD=

# Where to send the report (defaults to GMAIL_ADDRESS if not set)
RECIPIENT_EMAIL=d.mcderm80@gmail.com

# Optional tuning
# LOOKBACK_DAYS=30     # Only fetch comments from last N days (0 = all time)
# MAX_VIDEOS=10        # Number of recent videos to check
