# YouTube Data API v3
YOUTUBE_API_KEY=your_youtube_api_key_here
YOUTUBE_CHANNEL_ID=UCxxxxxxxxxxxxxxxxxxxx   # Your channel ID (starts with UC)

# Anthropic (Claude)
ANTHROPIC_API_KEY=sk-ant-...

# Gmail — use an App Password, not your account password
# Generate one at: https://myaccount.google.com/apppasswords
EMAIL_FROM=you@gmail.com
EMAIL_TO=you@gmail.com
EMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Optional tuning
VIDEOS_TO_CHECK=5       # How many recent videos to scan
COMMENTS_PER_VIDEO=100  # Max comments pulled per video
