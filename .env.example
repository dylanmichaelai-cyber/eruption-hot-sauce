# ── YouTube ───────────────────────────────────────────────────────────────────
# YouTube Data API v3 key (from console.cloud.google.com)
YOUTUBE_API_KEY=YOUR_YOUTUBE_API_KEY_HERE

# Your channel ID — find it at:
#   YouTube Studio → Settings → Channel → Advanced settings
#   or in the URL: youtube.com/channel/UC<this_part>
YOUTUBE_CHANNEL_ID=UCxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Anthropic ─────────────────────────────────────────────────────────────────
# Get your key at console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# ── Email (Gmail SMTP) ────────────────────────────────────────────────────────
# The Gmail address the report is sent FROM (must own the App Password below)
EMAIL_FROM=you@gmail.com

# Where to deliver the report (can be same address)
EMAIL_TO=you@gmail.com

# Gmail App Password — NOT your regular Gmail password.
# Generate one at: myaccount.google.com → Security → App Passwords
# (Requires 2-Step Verification to be enabled on the account)
EMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# ── Tuning (optional) ─────────────────────────────────────────────────────────
MAX_VIDEOS=25               # how many recent videos to scan
MAX_COMMENTS_PER_VIDEO=75   # comments fetched per video (sorted by relevance)
