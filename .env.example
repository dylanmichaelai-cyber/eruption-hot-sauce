# ── YouTube Data API ──────────────────────────────────────────────────────────
# Get your API key at https://console.cloud.google.com → APIs & Services → Credentials
YOUTUBE_API_KEY=YOUR_YOUTUBE_API_KEY_HERE

# Your channel ID (looks like UC_xxxxxxxxxxxxxxxxxxxxxxxx)
# Find it at: youtube.com → Your channel → About → Share → Copy channel ID
# Or go to https://www.youtube.com/@YourHandle and look in the page source for "channelId"
YOUTUBE_CHANNEL_ID=UC_YOUR_CHANNEL_ID_HERE

# ── Anthropic (Claude) ────────────────────────────────────────────────────────
# Get your key at https://console.anthropic.com
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY_HERE

# ── Email (Gmail SMTP) ────────────────────────────────────────────────────────
# The Gmail address that will SEND the report
EMAIL_FROM=you@gmail.com

# The address that will RECEIVE the report (can be the same)
EMAIL_TO=you@gmail.com

# Gmail App Password (NOT your regular password).
# Generate one at: myaccount.google.com → Security → App passwords
# Requires 2-Step Verification to be enabled.
EMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# ── Optional tuning ───────────────────────────────────────────────────────────
# How many recent videos to analyze
MAX_VIDEOS=5

# How many comments to pull per video (max 100)
MAX_COMMENTS_PER_VIDEO=50
