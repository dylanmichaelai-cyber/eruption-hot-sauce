# YouTube Data API v3 key
# Get one at https://console.cloud.google.com → APIs & Services → Credentials
YOUTUBE_API_KEY=your_youtube_api_key_here

# Your YouTube channel ID (looks like UCxxxxxxxxxxxxx)
# Run: python find_channel_id.py  to discover yours
YOUTUBE_CHANNEL_ID=your_channel_id_here

# Anthropic API key for Claude analysis
# Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Gmail address you want to send FROM (must be a Gmail account)
GMAIL_ADDRESS=you@gmail.com

# Gmail App Password (NOT your regular password)
# Enable 2FA then visit: https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Email address to send the summary TO (defaults to GMAIL_ADDRESS if omitted)
RECIPIENT_EMAIL=you@gmail.com

# How many days of videos to look back (default: 7)
DAYS_BACK=7

# Max number of recent videos to analyze (default: 10)
MAX_VIDEOS=10

# Max comments to fetch per video (default: 100)
MAX_COMMENTS_PER_VIDEO=100
