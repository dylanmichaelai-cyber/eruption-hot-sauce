# YouTube Comment Digest — environment variables
# Copy this file to .env and fill in your values.
# .env is git-ignored so your secrets stay local.

# YouTube Data API v3 key (console.cloud.google.com → APIs & Services → Credentials)
YOUTUBE_API_KEY=YOUR_YOUTUBE_API_KEY_HERE

# Your YouTube channel ID (starts with UC) or @handle
# Find it at: youtube.com → your avatar → Settings → Advanced settings
YOUTUBE_CHANNEL_ID=UCxxxxxxxxxxxxxxxxxxxxxxxx

# Anthropic API key for Claude analysis (console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# Email settings
EMAIL_TO=your@email.com
EMAIL_FROM=your.gmail@gmail.com

# Gmail App Password (NOT your Google account password)
# Enable 2FA on your Google account first, then go to:
# myaccount.google.com → Security → 2-Step Verification → App passwords
# Create one for "Mail" and paste the 16-character code below:
EMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
