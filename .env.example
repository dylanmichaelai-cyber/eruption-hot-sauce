# ── YouTube ───────────────────────────────────────────────────────────────────
YOUTUBE_API_KEY=AIzaSy...
# Your channel ID — find it at youtube.com/account_advanced
# If not set, the script will search by YOUTUBE_CHANNEL_NAME automatically
YOUTUBE_CHANNEL_ID=UCxxxxxxxxxxxxxxxxxxxxxxx
YOUTUBE_CHANNEL_NAME=Eruption Hot Sauce

# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Email (Gmail SMTP) ────────────────────────────────────────────────────────
EMAIL_FROM=you@gmail.com
EMAIL_TO=you@gmail.com
# Generate an App Password at: https://myaccount.google.com/apppasswords
