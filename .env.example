# ── YouTube ────────────────────────────────────────────────────────────────────
# Your YouTube Data API v3 key (Google Cloud Console → APIs & Services → Credentials)
# Make sure "YouTube Data API v3" is enabled for this project:
#   https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=AIzaSyDrPa11MXDW3V6A6HU3_mPt7klQjJp5T8c

# Your channel ID — find it at:
#   YouTube Studio → Settings → Channel → Advanced settings → "Channel ID"
#   It looks like: UCxxxxxxxxxxxxxxxxxxxxxx
YOUTUBE_CHANNEL_ID=

# How many recent videos and comments to pull (defaults shown)
MAX_VIDEOS=10
MAX_COMMENTS_PER_VIDEO=50

# ── Claude (Anthropic) ─────────────────────────────────────────────────────────
# Get your key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ── Email (Gmail) ──────────────────────────────────────────────────────────────
# Your Gmail address
GMAIL_USER=d.mcderm80@gmail.com

# Gmail App Password (NOT your regular password).
# Enable 2FA on your Google account, then generate one at:
#   https://myaccount.google.com/apppasswords
# Choose "Mail" + "Other (Custom name)" → copy the 16-char password here
GMAIL_APP_PASSWORD=

# Who to send the report to (defaults to GMAIL_USER if left blank)
EMAIL_TO=d.mcderm80@gmail.com
